# Vercel / server-side (Project Settings → Environment Variables)
# Get Formspree id from https://formspree.io → form endpoint: https://formspree.io/f/THIS_PART
FORMSPREE_FORM_ID=
WEB3FORMS_ACCESS_KEY=

# Chat (Vercel env — same key as Call Tracker / inbound)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — also set in config.js for the Calendly embed on site
CALENDLY_URL=

# GitHub (local only — do not commit .env)
# githubtoken=
